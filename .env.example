# ── Server ──────────────────────────────────────
PORT=4000

# Postgres connection string
# Local:      postgres://postgres:password@localhost:5432/watchparty
# Render:     copied from Render Postgres dashboard
DATABASE_URL=postgres://postgres:password@localhost:5432/watchparty

# Secret for signing session cookies — use a long random string in prod
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# ── CORS ────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# ── Client (Vite) ───────────────────────────────
# Local dev: http://localhost:4000
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:4000
